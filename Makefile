# MiniOS build — needs: gcc (with -m32 support) or i686-elf-gcc, nasm, GNU ld, qemu-system-i386
# Override the toolchain, e.g.:  make CC=i686-elf-gcc LD=i686-elf-ld

CC      = gcc
LD      = ld
AS      := nasm
QEMU    ?= qemu-system-i386

COMMON  := -m32 -std=gnu11 -ffreestanding -fno-pie -fno-pic -fno-stack-protector \
           -fno-builtin -nostdlib -mno-red-zone -mgeneral-regs-only -O2 -Wall -Wextra
CFLAGS  := $(COMMON) -Iinclude -g
UCFLAGS := $(COMMON) -Iinclude -Iuser
ASFLAGS := -f elf32
LDFLAGS := -m elf_i386 -T linker.ld -nostdlib

all: build/minios.elf

# ---------------- user programs ----------------
USER_PROGS := $(basename $(notdir $(wildcard user/bin/*.c)))
USER_ELFS  := $(patsubst %,build/user/%.elf,$(USER_PROGS))
ULIB       := build/user/crt0.o build/user/libc.o
LD_NORWX   := $(shell $(LD) --help 2>/dev/null | grep -q no-warn-rwx && echo --no-warn-rwx-segments)

build/user/crt0.o: user/crt0.asm
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) $< -o $@

build/user/libc.o: user/libc.c user/libc.h include/abi.h
	@mkdir -p $(dir $@)
	$(CC) $(UCFLAGS) -c $< -o $@

build/user/bin/%.o: user/bin/%.c user/libc.h include/abi.h
	@mkdir -p $(dir $@)
	$(CC) $(UCFLAGS) -c $< -o $@

# -n: don't page-align segments (smaller files), -s: strip symbols
build/user/%.elf: build/user/bin/%.o $(ULIB) user/user.ld
	$(LD) -m elf_i386 -T user/user.ld -n -s $(LD_NORWX) -o $@ build/user/crt0.o $< build/user/libc.o

# Embed every user ELF into the kernel; kmain copies them into /bin at boot
build/userbins.asm: $(USER_ELFS)
	@mkdir -p build
	@{ echo "; generated by the Makefile - do not edit"; \
	   echo "section .rodata"; echo "align 4"; echo "global user_programs"; echo "user_programs:"; \
	   for p in $(USER_PROGS); do echo "    dd name_$$p, bin_$$p, bin_$$p""_end - bin_$$p"; done; \
	   echo "    dd 0, 0, 0"; \
	   for p in $(USER_PROGS); do \
	     echo "name_$$p: db \"$$p\", 0"; echo "align 4"; \
	     echo "bin_$$p: incbin \"build/user/$$p.elf\""; echo "bin_$$p""_end:"; done; \
	   echo "section .note.GNU-stack noalloc noexec nowrite progbits"; } > $@

build/userbins.o: build/userbins.asm
	$(AS) $(ASFLAGS) $< -o $@

# ---------------- kernel ----------------
C_SRCS  := $(wildcard kernel/*.c)
ASM_SRCS:= $(wildcard boot/*.asm)
OBJS    := $(patsubst %.asm,build/%.o,$(ASM_SRCS)) $(patsubst %.c,build/%.o,$(C_SRCS)) build/userbins.o

KERNEL  := build/minios.elf


build/kernel/%.o: kernel/%.c $(wildcard include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

build/boot/%.o: boot/%.asm
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) $< -o $@

$(KERNEL): $(OBJS) linker.ld
	$(LD) $(LDFLAGS) -o $@ $(OBJS)
	@echo "Built $@ with user programs: $(USER_PROGS)"

# Window with VGA screen; serial log also goes to the terminal
run: $(KERNEL)
	$(QEMU) -kernel $(KERNEL) -m 128M -serial stdio

# Headless: everything on the terminal (no VGA window). Quit: Ctrl+A then X
run-nographic: $(KERNEL)
	$(QEMU) -kernel $(KERNEL) -m 128M -nographic

# Paused, waiting for gdb:  gdb build/minios.elf -ex "target remote :1234"
debug: $(KERNEL)
	$(QEMU) -kernel $(KERNEL) -m 128M -serial stdio -s -S

clean:
	rm -rf build

.PHONY: all run run-nographic debug clean
.SECONDARY:
